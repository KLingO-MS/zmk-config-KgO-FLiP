        mlc_qu: macro_lc_qu {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <5>;
            bindings
                = <&kp Q>
                , <&kp U>
                ;
        };

        mlc_qua: macro_lc_qua {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <5>;
            bindings
                = <&kp Q>
                , <&kp U>
                , <&kp A>
                ;
        };

        // mlc_th: macro_lc_th {
        //     compatible = "zmk,behavior-macro";
        //     #binding-cells = <0>;
        //     wait-ms = <0>;
        //     tap-ms = <5>;
        //     bindings
        //         = <&kp T>
        //         , <&kp H>
        //         ;
        // };

        // mlc_mpl: macro_lc_mpl {
        //     compatible = "zmk,behavior-macro";
        //     #binding-cells = <0>;
        //     wait-ms = <0>;
        //     tap-ms = <5>;
        //     bindings
        //         = <&kp M>
        //         , <&kp P>
        //         , <&kp L>
        //         ;
        // };
    };

    combos {
        compatible = "zmk,combos";
// ------------------------- LAYER COMBOS --------------------------------
        // combo_BOOT {
        //     timeout-ms = <50>;
        //     key-positions = <LMC LTC>;
        //     bindings = <&bootloader>;
        //     layers = <_BTF>;
        // };

        combo_BTF1 {
            timeout-ms = <50>;
            key-positions = <LHI RHI>;
            bindings = <&mo _BTF>;
            layers = <_BASE _SYM _NAV>;
        };

        // combo_BTF2 {
        //     timeout-ms = <50>;
        //     key-positions = <LHI LHO>;
        //     bindings = <&mo _BTF>;
        //     layers = <_BASE _SYM _NAV>;
        // };

        // combo_BTF3 {
        //     timeout-ms = <50>;
        //     key-positions = <RHO RHI>;
        //     bindings = <&mo _BTF>;
        //     layers = <_BASE _SYM _NAV>;
        // };

        combo_BTCLR {
            timeout-ms = <50>;
            key-positions = <LBR LBM LBI>;
            bindings = <&bt BT_CLR>;
            layers = <_BTF>;
        };

        combo_NAVR {
            timeout-ms = <50>;
            require-prior-idle-ms = <300>;
            key-positions = <RMI RMM RMR>;
            bindings = <&tog _NAV>;
            layers = <_BASE _SYM _NAV>;
        };

        combo_NAVL {
            timeout-ms = <50>;
            require-prior-idle-ms = <300>;
            key-positions = <LMI LMM LMR>;
            bindings = <&tog _NAV>;
            layers = <_BASE _SYM _NAV>;
        };

// ------------------------- MODS COMBOS --------------------------------
        combo_CAPS {
            timeout-ms = <50>;
            key-positions = <LMI RMI>;
            bindings = <&caps_word>;
            require-prior-idle-ms = <200>;
            layers = <_BASE>;
        };

// ------------------------- CHARACTER COMBOS --------------------------------
        // combo_MPL {
        //     timeout-ms = <200>;
        //     key-positions = <LTP LTR LTM>;
        //     bindings = <&mlc_mpl>;
        //     layers = <_BASE>;
        // };

        // combo_OU {
        //     timeout-ms = <185>;
        //     key-positions = <RTM RTR>;
        //     bindings = <&mlc_ou>;
        //     layers = <_BASE>;
        // };

        combo_QU {
            timeout-ms = <200>;
            key-positions =<RBM RBI>;
            bindings = <&mlc_qu>;
            layers = <_BASE>;
        };

        combo_QUA {
            timeout-ms = <200>;
            key-positions =<RBM RBI RBR>;
            bindings = <&mlc_qua>;
            layers = <_BASE>;
        };

        // combo_TH {
        //     timeout-ms = <185>;
        //     key-positions =<LMM LMI>;
        //     bindings = <&mlc_th>;
        //     layers = <_BASE>;
        // };

        // combo_ING {
        //     timeout-ms = <100>;
        //     key-positions = <RMI RMM RMR>;
        //     bindings = <&mlc_ing>;
        //     layers = <_BASE>;
        // };

// ------------------------- SYMBOL COMBOS --------------------------------
        combo_LPAR {
            timeout-ms = <50>;
            require-prior-idle-ms = <200>;
            key-positions = <LHI LMI>;
            bindings = <&kp LPAR>;
            layers = <_BASE _SYM>;
        };

        combo_RPAR {
            timeout-ms = <50>;
            require-prior-idle-ms = <200>;
            key-positions = <RMI RHI>;
            bindings = <&kp RPAR>;
            layers = <_BASE _SYM>;
        };

        combo_LBRC {
            timeout-ms = <50>;
            require-prior-idle-ms = <200>;
            key-positions = <LMR LHI>;
            bindings = <&kp LBRC>;
            layers = <_BASE _SYM>;
        };

        combo_RBRC {
            timeout-ms = <50>;
            require-prior-idle-ms = <200>;
            key-positions = <RHI RMR>;
            bindings = <&kp RBRC>;
            layers = <_BASE _SYM>;
        };

        combo_LBKT {
            timeout-ms = <50>;
            require-prior-idle-ms = <200>;
            key-positions = <LMM LHI>;
            bindings = <&kp LBKT>;
            layers = <_BASE _SYM>;
        };

        combo_RBKT {
            timeout-ms = <50>;
            require-prior-idle-ms = <200>;
            key-positions = <RHI RMM>;
            bindings = <&kp RBKT>;
            layers = <_BASE _SYM>;
        };

        combo_GT {
            timeout-ms = <50>;
            require-prior-idle-ms = <200>;
            key-positions = <RMP RHI>;
            bindings = <&kp GT>;
            layers = <_BASE _SYM>;
        };

        combo_LT {
            timeout-ms = <50>;
            require-prior-idle-ms = <200>;
            key-positions = <LMP LHI>;
            bindings = <&kp LT>;
            layers = <_BASE _SYM>;
        };

// ------------------------- UTILITY COMBOS --------------------------------
        combo_UNLCK {
            timeout-ms = <40>;
            key-positions = <LMC RMC>;
            bindings = <&studio_unlock>;
            layers = <_BASE>;
            require-prior-idle-ms = <200>;
        };
        
    };

    behaviors {
// ----------------------- ADAPTIVE-KEYS ------------------------------- 
        ak_d: ak_d {
            compatible = "zmk,behavior-adaptive-key";
            #binding-cells = <0>;
            bindings = <&kp D>;

            akt_th { trigger-keys = <T>; max-prior-idle-ms = <250>; bindings = <&kp H>; };
            akt_bh { trigger-keys = <B>; max-prior-idle-ms = <250>; bindings = <&kp H>; };
            akt_ph { trigger-keys = <P>; max-prior-idle-ms = <300>; bindings = <&kp H>; };
            akt_ch { trigger-keys = <C>; max-prior-idle-ms = <300>; bindings = <&kp H>; };
            akt_wh { trigger-keys = <W>; max-prior-idle-ms = <300>; bindings = <&kp H>; };
            akt_sh { trigger-keys = <S>; max-prior-idle-ms = <300>; bindings = <&kp H>; };
            akt_gh { trigger-keys = <G>; max-prior-idle-ms = <300>; bindings = <&kp H>; };
        };

        // ak_h: ak_h {
        //     compatible = "zmk,behavior-adaptive-key";
        //     #binding-cells = <0>;
        //     bindings = <&kp H>;

        //     akt_mp { trigger-keys = <M>; max-prior-idle-ms = <250>; bindings = <&kp P>; };
        //     // akt_ld { trigger-keys = <L>; max-prior-idle-ms = <200>; bindings = <&kp D>; };
        // };

        // ak_x: ak_x {
        //     compatible = "zmk,behavior-adaptive-key";
        //     #binding-cells = <0>;
        //     bindings = <&kp X>;

        //     akt_qu { trigger-keys = <Q>; max-prior-idle-ms = <250>; bindings = <&kp U>; };
        //     akt_zo { trigger-keys = <Z>; max-prior-idle-ms = <250>; bindings = <&kp O>; };
        // };

        // ak_q: ak_q {
        //     compatible = "zmk,behavior-adaptive-key";
        //     #binding-cells = <0>;
        //     bindings = <&kp Q>;

        //     akt_qua { trigger-keys = <U>; max-prior-idle-ms = <150>; bindings = <&kp A>; };
        //     // akt_zu { trigger-keys = <Z>; max-prior-idle-ms = <250>; bindings = <&kp U>; };
        //     // akt_gs { trigger-keys = <G>; max-prior-idle-ms = <250>; bindings = <&kp S>; };
        //     // akt_ws { trigger-keys = <W>; max-prior-idle-ms = <250>; bindings = <&kp S>; };
        // };

        ak_o: ak_o {
            compatible = "zmk,behavior-adaptive-key";
            #binding-cells = <0>;
            bindings = <&kp O>;

            akt_uo { trigger-keys = <U>; max-prior-idle-ms = <150>; bindings = <&kp LSHIFT>; };
        };

        ak_u: ak_u {
            compatible = "zmk,behavior-adaptive-key";
            #binding-cells = <0>;
            bindings = <&kp U>;

            akt_you { trigger-keys = <Y>; max-prior-idle-ms = <200>; bindings = <&kp O &kp U>; };
        };

        // ak_z: ak_z {
        //     compatible = "zmk,behavior-adaptive-key";
        //     #binding-cells = <0>;
        //     bindings = <&kp Z>;

        //     akt_xa { trigger-keys = <X>; max-prior-idle-ms = <250>; bindings = <&kp U>; };
        // };

// ------------------------- TAP-DANCES --------------------------------
        cp_c: cp_c {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <400>;
            bindings = <&kp LC(C)>, <&kp LG(C)>;
        };

        cp_v: cp_v {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <400>;
            bindings = <&kp LC(V)>, <&kp LG(V)>;
        };

        cp_x: cp_x {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <400>;
            bindings = <&kp LC(X)>, <&kp LG(X)>;
        };

// ------------------------- HOLD-TAPS --------------------------------
        /* left-hand HRMs */
        hml: hrm_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <300>;
            quick-tap-ms = <170>;                // repeat on tap-into-hold
            require-prior-idle-ms = <300>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_R THUMBS>;
            hold-trigger-on-release;             // delay positional check until key-release
        };

        /* right-hand HRMs */
        hmr: hrm_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <300>;
            quick-tap-ms = <170>;                // repeat on tap-into-hold
            require-prior-idle-ms = <300>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_L THUMBS>;
            hold-trigger-on-release;             // delay positional check until key-release
        };

        asl: aks_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <250>;
            quick-tap-ms = <170>;                // repeat on tap-into-hold
            require-prior-idle-ms = <120>;
            bindings = <&kp>, <&ak_d>;
            hold-trigger-key-positions = <KEYS_R THUMBS>;
            hold-trigger-on-release;             // delay positional check until key-release
        };

        hsl: hrs_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <250>;
            quick-tap-ms = <170>;                // repeat on tap-into-hold
            require-prior-idle-ms = <120>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_R THUMBS>;
            hold-trigger-on-release;             // delay positional check until key-release
        };

        hsr: hrs_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <250>;
            quick-tap-ms = <170>;                // repeat on tap-into-hold
            require-prior-idle-ms = <120>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_L THUMBS>;
            hold-trigger-on-release;             // delay positional check until key-release
        };

        bst: backspace-tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <300>;
            quick-tap-ms = <170>;
            //require-prior-idle-ms = <100>;
            bindings = <&mo>, <&kp>;
        };

        spt: space-tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <300>;
            quick-tap-ms = <170>;
            // require-prior-idle-ms = <120>;
            bindings = <&mo>, <&kp>;
        };

// ------------------------- MOD-MORPHS --------------------------------
        // mm_you: mm_you {
        //     compatible = "zmk,behavior-mod-morph";
        //     #binding-cells = <0>;
        //     bindings = <&mlc_you>, <&muc_you>;
        //     mods = <(MOD_LSFT)>;
        // };

        // mm_the: mm_the {
        //     compatible = "zmk,behavior-mod-morph";
        //     #binding-cells = <0>;
        //     bindings = <&mlc_the>, <&muc_the>;
        //     mods = <(MOD_LSFT)>;
        // };
    };

    keymap {
        compatible = "zmk,keymap";

                base_layer {
                    display-name = "Base";
// -------------------------------    -------------------------------
// |  P  |  L  |  M  |  B  |  F  |    |  W  |  C  |  O  |  U  |  Y  |
// |  N  |  R  |  T  |  D  |  H  |    |  G  |  S  |  A  |  E  |  I  |
//       |  J  |  V  |  K  |                |  Z  |  X  |  Q  |
//        | _NAV(=) | _SYM(BSPC) |    | _NAV(SPC) | _SYM(+) |
                        bindings = <
   &kp P        &kp L        &kp M       &kp B        &kp F           &kp W  &kp C        &ak_o       &ak_u        &kp Y
   &hml LALT N  &hml LCTRL R &hml LGUI T &asl LSHFT D &kp H           &kp G  &hsr LSHFT S &hmr LGUI A &hmr LCTRL E &hmr LALT I 
                &kp J        &kp V       &kp K                               &kp Z        &kp X       &kp Q
                                     &bst _MOUS EQUAL  &bst _SYM BSPC  &spt _NAV SPACE  &spt _BTF PLUS
                        >;
                };

                nav_layer {
                    display-name = "Num - Nav";
// -------------------------------    ---------------------------------
// |  8  |  6  |  4  |  2  | INS |    | pUP | HOME |  UP | END  | ESC |
// |  7  |  5  |  3  |  1  | PSC |    | pDN | LEFT | SPC | RGHT | RET |
//       | . , |  9  |  0  |                | TAB  |  DN | DEL  |
//                  | RET | BSPC |    | LSFT | BSPC |
                        bindings = <
   &kp N8        &kp N6        &kp N4       &kp N2        &kp INS         &kp PG_UP  &kp HOME        &kp UP          &kp END          &kp ESC
   &hml LALT N7  &hml LCTRL N5 &hml LGUI N3 &hsl LSHFT N1 &kp PSCRN       &kp PG_DN  &hsr LSHFT LEFT &hmr LGUI SPACE &hmr LCTRL RIGHT &hmr LALT RET
                 &kp KP_DOT    &kp N9       &kp N0                                   &kp TAB         &kp DOWN        &kp DEL
                                                &kp RET   &bst _SYM BSPC  &kp LSHFT  &kp BSPC
                        >;
                };
                
                sym_layer {
                    display-name = "Symbols";
// -------------------------------    -------------------------------
// |  \  |  |  |  _  |  =  | F13 |    |  ~  |  "  |  ;  |  :  |  !  |
// |  /  |  *  |  -  |  +  | F16 |    |  `  |  '  |  ,  |  .  |  ?  |
//       |  &  |  ^  |  %  |                |  @  |  #  |  $  |
//                  |     | BSPC |    | SPC | BSPC |
                        bindings = <
   &kp BSLH        &kp PIPE        &kp UNDER       &kp EQUAL       &kp F13       &kp TILDE &kp DQT        &kp SEMI        &kp COLON      &kp EXCL
   &hml LALT SLASH &hml LCTRL STAR &hml LGUI MINUS &hsl LSHFT PLUS &kp F16       &kp GRAVE &hsr LSHFT SQT &hmr LGUI COMMA &hmr LCTRL DOT &hmr LALT QMARK
                   &kp AMPS        &kp CARET       &kp PRCNT                               &kp AT         &kp HASH        &kp DLLR
                                                          &none    &kp BSPC      &spt _NAV SPACE  &kp BSPC
                        >;
                };

                btf_layer {
                    display-name = "BT - Func";
// -------------------------------    -----------------------------
// | BT1 | BT2 | BT3 | BT4 | BT5 |    | F12 | F2  | F4 | F6  | F8 |
// | ALT | CTL | GUI | SFT | USB |    | F11 | F1  | F3 | F5  | F7 |
//       |  v. |  v- |  v+ |                | F10 | F9 | APP |
//                   | BR- | BR+ |    |     |     |
                        bindings = <
   &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4   &kp F12 &kp F2  &kp F4 &kp F6    &kp F8
   &kp LALT     &kp LCTRL    &kp LGUI     &kp LSHFT    &out OUT_TOG   &kp F11 &kp F1  &kp F3 &kp F5    &kp F7
                &kp C_MUTE   &kp C_VOL_DN &kp C_VOL_UP                        &kp F10 &kp F9 &kp K_APP
                                        &kp C_BRI_DEC &kp C_BRI_INC   &none   &none
                        >;
                };

                mouse_layer {
                    display-name = "Mouse";
// -------------------------------    ---------------------------------------
// |     | cut | cpy | pst | F13 |    | SCup | SCleft |  Mup  | SCrght |     |
// | ALT | CTL | GUI | SFT | F16 |    | SCdn | Mleft  |       | Mrght  | B2  |
//       |  v. |  v- |  v+ |                 |   B4   | Mdown |   B5   |
//                   |     |     |    |  B1  | B3 |
                        bindings = <
   &none    &cp_x      &cp_c        &cp_v        &kp F13   &msc SCRL_UP   &msc SCRL_LEFT &mmv MOVE_UP   &msc SCRL_RIGHT &none
   &kp LALT &kp LCTRL  &kp LGUI     &kp LSHIFT   &kp F16   &msc SCRL_DOWN &mmv MOVE_LEFT &none          &mmv MOVE_RIGHT &mkp MB2
            &kp C_MUTE &kp C_VOL_DN &kp C_VOL_UP                          &mkp MB4       &mmv MOVE_DOWN &mkp MB5
                                        &none    &none     &mkp MB1    &mkp MB3
                        >;
                };

                extra1 {
                        status = "reserved";
                };

                extra2 {
                        status = "reserved";
                };
    };
};
