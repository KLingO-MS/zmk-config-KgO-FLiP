        mlc_ou: macro_ou {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <5>;
            bindings
                = <&kp O>
                , <&kp U>
                ;
        };

        mlc_qu: macro_lc_qu {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <5>;
            bindings
                = <&kp Q>
                , <&kp U>
                ;
        };

        // mlc_qua: macro_lc_qua {
        //     compatible = "zmk,behavior-macro";
        //     #binding-cells = <0>;
        //     wait-ms = <0>;
        //     tap-ms = <5>;
        //     bindings
        //         = <&kp Q>
        //         , <&kp U>
        //         , <&kp A>
        //         ;
        // };

        // mlc_th: macro_lc_th {
        //     compatible = "zmk,behavior-macro";
        //     #binding-cells = <0>;
        //     wait-ms = <0>;
        //     tap-ms = <5>;
        //     bindings
        //         = <&kp T>
        //         , <&kp H>
        //         ;
        // };

        // mlc_mpl: macro_lc_mpl {
        //     compatible = "zmk,behavior-macro";
        //     #binding-cells = <0>;
        //     wait-ms = <0>;
        //     tap-ms = <5>;
