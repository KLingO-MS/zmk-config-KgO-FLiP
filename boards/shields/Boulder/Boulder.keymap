    };

    combos {
        compatible = "zmk,combos";
// ------------------------- LAYER COMBOS --------------------------------
        // combo_BOOT {
        //     timeout-ms = <50>;
        //     key-positions = <LMC LTC>;
        //     bindings = <&bootloader>;
        //     layers = <_BTF>;
        // };

        combo_BTF {
            timeout-ms = <50>;
            key-positions = <LHI RHI>;
            bindings = <&mo _BTF>;
            layers = <_BASE _SYM _NAV>;
        };

        // combo_BTF2 {
        //     timeout-ms = <50>;
        //     key-positions = <LHI LHO>;
        //     bindings = <&mo _BTF>;
        //     layers = <_BASE _SYM _NAV>;
        // };

        // combo_BTF3 {
        //     timeout-ms = <50>;
        //     key-positions = <RHO RHI>;
        //     bindings = <&mo _BTF>;
        //     layers = <_BASE _SYM _NAV>;
        // };

        combo_BTCLR {
            timeout-ms = <50>;
            key-positions = <LBR LBM LBI>;
            bindings = <&bt BT_CLR>;
            layers = <_BTF>;
        };

        // combo_NAVR {
        //     timeout-ms = <50>;
        //     require-prior-idle-ms = <300>;
        //     key-positions = <RMI RMM RMR>;
        //     bindings = <&tog _NAV>;
        //     layers = <_BASE _SYM _NAV>;
        // };

        // combo_NAVL {
        //     timeout-ms = <50>;
        //     require-prior-idle-ms = <300>;
        //     key-positions = <LMI LMM LMR>;
        //     bindings = <&tog _NAV>;
        //     layers = <_BASE _SYM _NAV>;
        // };

// ------------------------- MODS COMBOS --------------------------------
        combo_CAPS {
            timeout-ms = <50>;
            key-positions = <LTI RTI>;
            bindings = <&caps_word>;
            require-prior-idle-ms = <200>;
            layers = <_BASE>;
        };

// ------------------------- CHARACTER COMBOS --------------------------------
        // combo_MPL {
        //     timeout-ms = <200>;
        //     key-positions = <LTP LTR LTM>;
        //     bindings = <&mlc_mpl>;
        //     layers = <_BASE>;
        // };

        combo_OU {
            timeout-ms = <300>;
            key-positions = <RTM RTR>;
            bindings = <&mlc_ou>;
            layers = <_BASE>;
        };

        combo_QU {
            timeout-ms = <300>;
            key-positions =<RBM RBI>;
            bindings = <&mlc_qu>;
            layers = <_BASE>;
        };

        // combo_QUA {
        //     timeout-ms = <200>;
        //     key-positions =<RBM RBI RBR>;
        //     bindings = <&mlc_qua>;
        //     layers = <_BASE>;
        // };

        // combo_TH {
        //     timeout-ms = <185>;
        //     key-positions =<LMM LMI>;
        //     bindings = <&mlc_th>;
        //     layers = <_BASE>;
        // };

        // combo_ING {
        //     timeout-ms = <100>;
        //     key-positions = <RMI RMM RMR>;
        //     bindings = <&mlc_ing>;
        //     layers = <_BASE>;
        // };

// ------------------------- SYMBOL COMBOS --------------------------------
        combo_LPAR {
            timeout-ms = <50>;
            require-prior-idle-ms = <200>;
            key-positions = <LHI LMI>;
            bindings = <&kp LPAR>;
            layers = <_BASE _SYM>;
        };

        combo_RPAR {
            timeout-ms = <50>;
            require-prior-idle-ms = <200>;
            key-positions = <RMI RHI>;
            bindings = <&kp RPAR>;
            layers = <_BASE _SYM>;
        };

        combo_LBRC {
            timeout-ms = <50>;
            require-prior-idle-ms = <200>;
            key-positions = <LMR LHI>;
            bindings = <&kp LBRC>;
            layers = <_BASE _SYM>;
        };

        combo_RBRC {
            timeout-ms = <50>;
            require-prior-idle-ms = <200>;
            key-positions = <RHI RMR>;
            bindings = <&kp RBRC>;
            layers = <_BASE _SYM>;
        };

        combo_LBKT {
            timeout-ms = <50>;
            require-prior-idle-ms = <200>;
            key-positions = <LMM LHI>;
            bindings = <&kp LBKT>;
            layers = <_BASE _SYM>;
        };

        combo_RBKT {
            timeout-ms = <50>;
            require-prior-idle-ms = <200>;
            key-positions = <RHI RMM>;
            bindings = <&kp RBKT>;
            layers = <_BASE _SYM>;
        };

        combo_GT {
            timeout-ms = <50>;
            require-prior-idle-ms = <200>;
            key-positions = <RMP RHI>;
            bindings = <&kp GT>;
            layers = <_BASE _SYM>;
        };

        combo_LT {
            timeout-ms = <50>;
            require-prior-idle-ms = <200>;
            key-positions = <LMP LHI>;
            bindings = <&kp LT>;
            layers = <_BASE _SYM>;
        };

// ------------------------- UTILITY COMBOS --------------------------------
        combo_UNLCK {
            timeout-ms = <40>;
            key-positions = <LMC RMC>;
            bindings = <&studio_unlock>;
            layers = <_BASE>;
            require-prior-idle-ms = <200>;
        };
        
    };

    behaviors {
// ----------------------- ADAPTIVE-KEYS ------------------------------- 
        ak_d: ak_d {
            compatible = "zmk,behavior-adaptive-key";
            #binding-cells = <0>;
            bindings = <&kp D>;

            akt_th { trigger-keys = <T>; max-prior-idle-ms = <250>; bindings = <&kp H>; };
            akt_wh { trigger-keys = <W>; max-prior-idle-ms = <300>; bindings = <&kp H>; };
            akt_sh { trigger-keys = <S>; max-prior-idle-ms = <300>; bindings = <&kp H>; };
            akt_gh { trigger-keys = <G>; max-prior-idle-ms = <300>; bindings = <&kp H>; };
            akt_ch { trigger-keys = <C>; max-prior-idle-ms = <300>; bindings = <&kp H>; };

            akt_bn { trigger-keys = <B>; max-prior-idle-ms = <300>; bindings = <&kp N>; };

//            akt_mb { trigger-keys = <M>; max-prior-idle-ms = <300>; bindings = <&kp B>; };
        };

        ak_b: ak_b {
            compatible = "zmk,behavior-adaptive-key";
            #binding-cells = <0>;
            bindings = <&kp B>;

            akt_ph { trigger-keys = <P>; max-prior-idle-ms = <300>; bindings = <&kp H>; };
            akt_sc { trigger-keys = <S>; max-prior-idle-ms = <300>; bindings = <&kp C>; };
        };

        ak_r: ak_r {
            compatible = "zmk,behavior-adaptive-key";
            #binding-cells = <0>;
            bindings = <&kp R>;

            akt_ng { trigger-keys = <N>; max-prior-idle-ms = <300>; bindings = <&kp G>; };
        };

        ak_p: ak_p {
            compatible = "zmk,behavior-adaptive-key";
            #binding-cells = <0>;
            bindings = <&kp P>;

            akt_tv { trigger-keys = <T>; max-prior-idle-ms = <300>; bindings = <&kp V>; };
            akt_cr { trigger-keys = <C>; max-prior-idle-ms = <300>; bindings = <&kp R>; };
            akt_br { trigger-keys = <B>; max-prior-idle-ms = <300>; bindings = <&kp R>; };

//            akt_ws { trigger-keys = <W>; max-prior-idle-ms = <300>; bindings = <&kp S>; };
//            akt_gs { trigger-keys = <G>; max-prior-idle-ms = <300>; bindings = <&kp S>; };
        };

        ak_y: ak_y {
            compatible = "zmk,behavior-adaptive-key";
            #binding-cells = <0>;
            bindings = <&kp Y>;

            akt_ue { trigger-keys = <U>; max-prior-idle-ms = <300>; bindings = <&kp E>; };
        };

// ------------------------- TAP-DANCES --------------------------------
        cp_c: cp_c {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <400>;
            bindings = <&kp LC(C)>, <&kp LG(C)>;
        };

        cp_v: cp_v {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <400>;
            bindings = <&kp LC(V)>, <&kp LG(V)>;
        };

        cp_x: cp_x {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <400>;
            bindings = <&kp LC(X)>, <&kp LG(X)>;
        };

// ------------------------- HOLD-TAPS --------------------------------
        /* left-hand HRMs */
        hml: hrm_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <300>;
            quick-tap-ms = <170>;                // repeat on tap-into-hold
            require-prior-idle-ms = <300>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_R THUMBS>;
            hold-trigger-on-release;             // delay positional check until key-release
        };

        /* right-hand HRMs */
        hmr: hrm_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <300>;
            quick-tap-ms = <170>;                // repeat on tap-into-hold
            require-prior-idle-ms = <300>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_L THUMBS>;
            hold-trigger-on-release;             // delay positional check until key-release
        };

        rml: akr_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <300>;
            quick-tap-ms = <170>;                // repeat on tap-into-hold
            require-prior-idle-ms = <250>;
            bindings = <&kp>, <&ak_r>;
            hold-trigger-key-positions = <KEYS_R THUMBS>;
            hold-trigger-on-release;             // delay positional check until key-release
        };

        asl: aks_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <250>;
            quick-tap-ms = <170>;                // repeat on tap-into-hold
            // require-prior-idle-ms = <120>;
            bindings = <&kp>, <&ak_d>;
            hold-trigger-key-positions = <KEYS_R THUMBS>;
            hold-trigger-on-release;             // delay positional check until key-release
        };

        hsl: hrs_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <250>;
            quick-tap-ms = <170>;                // repeat on tap-into-hold
            // require-prior-idle-ms = <120>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_R THUMBS>;
            hold-trigger-on-release;             // delay positional check until key-release
        };

        hsr: hrs_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <250>;
            quick-tap-ms = <170>;                // repeat on tap-into-hold
            // require-prior-idle-ms = <120>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_L THUMBS>;
            hold-trigger-on-release;             // delay positional check until key-release
        };

        bst: backspace-tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <300>;
            quick-tap-ms = <170>;
            //require-prior-idle-ms = <100>;
            bindings = <&mo>, <&kp>;
        };

        spt: space-tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <300>;
            quick-tap-ms = <170>;
            // require-prior-idle-ms = <120>;
            bindings = <&mo>, <&kp>;
        };

// ------------------------- MOD-MORPHS --------------------------------
        // mm_you: mm_you {
        //     compatible = "zmk,behavior-mod-morph";
        //     #binding-cells = <0>;
        //     bindings = <&mlc_you>, <&muc_you>;
        //     mods = <(MOD_LSFT)>;
        // };

        // mm_the: mm_the {
        //     compatible = "zmk,behavior-mod-morph";
        //     #binding-cells = <0>;
        //     bindings = <&mlc_the>, <&muc_the>;
        //     mods = <(MOD_LSFT)>;
        // };
    };

    keymap {
        compatible = "zmk,keymap";

                base_layer {
                    display-name = "Base";
// -------------------------------    -------------------------------
// |  B  |  L  |  M  |  P  |  F  |    |  W  |  C  |  O  |  U  |  Y  |
// |  N  |  R  |  T  |  D  |  H  |    |  G  |  S  |  A  |  E  |  I  |
//       |  J  |  V  |  K  |                |  Z  |  X  |  Q  |
//        | _NAV(=) | _SYM(BSPC) |    | _NAV(SPC) | _SYM(+) |
                        bindings = <
   &ak_b        &kp L        &kp M       &ak_p        &kp F           &kp W  &kp C        &kp O       &kp U        &ak_y
   &hml LALT N  &rml LCTRL R &hml LGUI T &asl LSHFT D &kp H           &kp G  &hsr LSHFT S &hmr LGUI A &hmr LCTRL E &hmr LALT I 
                &kp J        &kp V       &kp K                               &kp Z        &kp X       &kp Q
                                     &bst _MOUS EQUAL  &bst _SYM BSPC  &spt _NAV SPACE  &spt _BTF PLUS
                        >;
                };

                nav_layer {
                    display-name = "Num - Nav";
// -------------------------------    ---------------------------------
// |  8  |  7  |  6  |  5  | INS |    | pUP | HOME |  UP | END  | ESC |
// |  4  |  3  |  2  |  1  | PSC |    | pDN | LEFT | SPC | RGHT | RET |
//       | . , |  9  |  0  |                | TAB  |  DN | DEL  |
//                  | RET | BSPC |    | LSFT | BSPC |
                        bindings = <
   &kp N8        &kp N7        &kp N6       &kp N5        &kp INS         &kp PG_UP  &kp HOME        &kp UP          &kp END          &kp ESC
   &hml LALT N4  &hml LCTRL N3 &hml LGUI N2 &hsl LSHFT N1 &kp PSCRN       &kp PG_DN  &hsr LSHFT LEFT &hmr LGUI SPACE &hmr LCTRL RIGHT &hmr LALT RET
                 &kp KP_DOT    &kp N9       &kp N0                                   &kp TAB         &kp DOWN        &kp DEL
                                                &kp RET   &bst _SYM BSPC  &kp LSHFT  &kp BSPC
                        >;
                };
                
                sym_layer {
                    display-name = "Symbols";
// -------------------------------    -------------------------------
// |  \  |  |  |  _  |  =  | F16 |    |  ~  |  "  |  ;  |  :  |  !  |
// |  /  |  *  |  -  |  +  | F13 |    |  `  |  '  |  ,  |  .  |  ?  |
//       |  &  |  ^  |  %  |                |  @  |  #  |  $  |
//                  |     | BSPC |    | SPC | BSPC |
                        bindings = <
   &kp BSLH        &kp PIPE        &kp UNDER       &kp EQUAL       &kp F16       &kp GRAVE &kp DQT        &kp SEMI        &kp COLON      &kp EXCL
   &hml LALT SLASH &hml LCTRL STAR &hml LGUI MINUS &hsl LSHFT PLUS &kp F13       &kp TILDE &hsr LSHFT SQT &hmr LGUI COMMA &hmr LCTRL DOT &hmr LALT QMARK
                   &kp AMPS        &kp CARET       &kp PRCNT                               &kp AT         &kp HASH        &kp DLLR
                                                          &none    &kp BSPC      &spt _NAV SPACE  &kp BSPC
                        >;
                };

                btf_layer {
                    display-name = "BT - Func";
// -------------------------------    -----------------------------
// | BT1 | BT2 | BT3 | BT4 | BT5 |    | F11 | F1 | F2  | F3  | F4 |
// | BR- | BR+ | VL- | VL+ | USB |    | F12 | F5 | F6  | F7  | F8 |
//       | cut | cpy | pst |                | F9 | F10 | APP |
//                   | BR- | BR+ |    |     |     |
                        bindings = <
   &bt BT_SEL 0        &bt BT_SEL 1         &bt BT_SEL 2       &bt BT_SEL 3          &bt BT_SEL 4   &kp F11 &kp F1  &kp F2  &kp F3    &kp F4
   &hml LALT C_BRI_DEC &hml LCTRL C_BRI_INC &hml LGUI C_VOL_DN &hsl LSHFT C_VOL_UP   &out OUT_TOG   &kp F12 &kp F5  &kp F6  &kp F7    &kp F8
                       &cp_x                &cp_c              &cp_v                                        &kp F9  &kp F10 &kp K_APP
                                                                     &none   &none   &none   &none
                        >;
                };

                mouse_layer {
                    display-name = "Mouse";
// -------------------------------    ---------------------------------------
// |     | cut | cpy | pst | F16 |    | SCup | SCleft |  Mup  | SCrght |     |
// | ALT | CTL | GUI | SFT | F13 |    | SCdn | Mleft  |       | Mrght  | B2  |
//       |  v. |  v- |  v+ |                 |   B4   | Mdown |   B5   |
//                   |     |     |    |  B1  | B3 |
                        bindings = <
   &none    &cp_x      &cp_c        &cp_v        &kp F16   &msc SCRL_UP   &msc SCRL_LEFT &mmv MOVE_UP   &msc SCRL_RIGHT &none
   &kp LALT &kp LCTRL  &kp LGUI     &kp LSHIFT   &kp F13   &msc SCRL_DOWN &mmv MOVE_LEFT &none          &mmv MOVE_RIGHT &mkp MB2
            &kp C_MUTE &kp C_VOL_DN &kp C_VOL_UP                          &mkp MB4       &mmv MOVE_DOWN &mkp MB5
                                        &none    &none     &mkp MB1    &mkp MB3
                        >;
                };

                extra1 {
                        status = "reserved";
                };

                extra2 {
                        status = "reserved";
                };
    };
};
